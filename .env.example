# Cofrete local-only infrastructure defaults.
# Copy this file to .env for personal overrides. Do not commit .env.

COFRETE_POSTGRES_DB=cofrete_local
COFRETE_POSTGRES_USER=cofrete
COFRETE_POSTGRES_PASSWORD=cofrete_local_password
COFRETE_POSTGRES_PORT=5432

COFRETE_RABBITMQ_USER=cofrete
COFRETE_RABBITMQ_PASSWORD=cofrete_local_password
COFRETE_RABBITMQ_VHOST=cofrete
COFRETE_RABBITMQ_AMQP_PORT=5672
COFRETE_RABBITMQ_MANAGEMENT_PORT=15672

COFRETE_MINIO_ROOT_USER=cofrete
COFRETE_MINIO_ROOT_PASSWORD=cofrete_local_password
COFRETE_MINIO_API_PORT=9000
COFRETE_MINIO_CONSOLE_PORT=9001
COFRETE_MINIO_BUCKET=cofrete-local

# Service connection placeholders used by upcoming service scaffolds.
COFRETE_CORE_API_DATABASE_URL=jdbc:postgresql://postgres:5432/cofrete_local
COFRETE_CORE_API_AMQP_URL=amqp://cofrete:cofrete_local_password@rabbitmq:5672/cofrete
COFRETE_CORE_API_OBJECT_STORAGE_ENDPOINT=http://minio:9000
COFRETE_CORE_API_OBJECT_STORAGE_BUCKET=cofrete-local

COFRETE_FINANCE_WORKER_DATABASE_URL=jdbc:postgresql://postgres:5432/cofrete_local
COFRETE_FINANCE_WORKER_AMQP_URL=amqp://cofrete:cofrete_local_password@rabbitmq:5672/cofrete

COFRETE_DATA_IMPORTER_DATABASE_URL=jdbc:postgresql://postgres:5432/cofrete_local
COFRETE_DATA_IMPORTER_AMQP_URL=amqp://cofrete:cofrete_local_password@rabbitmq:5672/cofrete
COFRETE_DATA_IMPORTER_OBJECT_STORAGE_ENDPOINT=http://minio:9000
COFRETE_DATA_IMPORTER_OBJECT_STORAGE_BUCKET=cofrete-local
COFRETE_DATA_IMPORTER_WORKER_PORT=8082
COFRETE_DATA_IMPORTER_SCHEDULER_ENABLED=false
